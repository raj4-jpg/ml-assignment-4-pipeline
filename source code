    "Row Count": [len(df_raw), X_train.shape[0] + X_test.shape[0]],
    "Column Count": [df_raw.shape[1], X_train.shape[1]],
    "Missing Values": [int(df_raw.isna().sum().sum()), int(np.isnan(X_train).sum() + np.isnan(X_test).sum())],
    "Duplicate Count": [int(df_raw.duplicated(subset=['customer_id']).sum()), 0]
})
