# ==============================================================================
# DATASET GENERATION (Raw messy data: 6,000 rows, 10 cols, mixed types)
# ==============================================================================
np.random.seed(42)
N = 6000

customer_ids = [f"CUST-{10000 + (i % 5850)}" for i in range(N)]
ages = np.random.normal(loc=38, scale=12, size=N).astype(int)
ages[np.random.choice(N, size=25, replace=False)] = -5

annual_spend = np.random.exponential(scale=1200, size=N) + 200
annual_spend[np.random.choice(N, size=320, replace=False)] = np.nan

delivery_dist = [
    f"{np.random.uniform(1.0, 55.0):.1f} km" if np.random.rand() > 0.15 
    else f"{np.random.uniform(0.6, 35.0):.1f} miles" for _ in range(N)
]

orders_placed = np.random.poisson(lam=8, size=N).astype(float)
orders_placed[np.random.choice(N, size=180, replace=False)] = np.nan

membership = np.random.choice(
    [" Gold", "gold", "GOLD", "Silver ", "silver", "SILVER", "Bronze", "bronze", "None"],
    size=N
)
service_calls = np.random.poisson(lam=2, size=N)
days_active = np.random.randint(10, 1200, size=N)
promo_code_used = np.random.choice([0, 1], size=N, p=[0.4, 0.6])
target_churn = np.random.choice([0, 1], size=N, p=[0.82, 0.18])

df_raw = pd.DataFrame({
    "customer_id": customer_ids,
    "age": ages,
    "annual_spend": annual_spend,
    "delivery_distance_raw": delivery_dist,
    "orders_placed": orders_placed,
    "membership_tier": membership,
    "service_calls": service_calls,
    "days_active": days_active,
    "promo_code_used": promo_code_used,
    "churn": target_churn
})
df_raw.to_csv("raw_customer_logistics.csv", index=False)

