# ==============================================================================
# 4. THE FOUR MODULAR FUNCTIONS
# ==============================================================================
def load_data(filepath="raw_customer_logistics.csv"):
    return pd.read_csv(filepath)

def clean(df):
    df_c = df.copy()
    df_c = df_c.drop_duplicates(subset=["customer_id"], keep="first").reset_index(drop=True)
    df_c.loc[df_c["age"] < 18, "age"] = np.nan

    def parse_distance_km(val):
        if pd.isna(val):
            return np.nan
        val_str = str(val).lower().strip()
        num = float(re.findall(r"[\d\.]+", val_str)[0])
        return num * 1.60934 if "mile" in val_str else num

    df_c["delivery_dist_km"] = df_c["delivery_distance_raw"].apply(parse_distance_km)
    df_c = df_c.drop(columns=["delivery_distance_raw"])
    df_c["membership_tier"] = df_c["membership_tier"].astype(str).str.strip().str.title()
    return df_c

def add_features(df):
    # 1. avg_spend_per_order: Measures basket size value density to identify high-margin clients.
    # 2. order_frequency_monthly: Quantifies platform engagement velocity normalized by customer tenure.
    # 3. support_intensity: Captures customer friction risk relative to total purchase frequency.
    # 4. is_vip_tier: Isolates high-tier enterprise loyalty accounts driving non-linear revenue.
    df_f = df.copy()
    df_f["avg_spend_per_order"] = df_f["annual_spend"] / np.maximum(df_f["orders_placed"], 1.0)
    df_f["order_frequency_monthly"] = df_f["orders_placed"] / np.maximum(df_f["days_active"] / 30.0, 1.0)
    df_f["support_intensity"] = df_f["service_calls"] / np.maximum(df_f["orders_placed"], 1.0)
    df_f["is_vip_tier"] = df_f["membership_tier"].isin(["Gold"]).astype(int)
    return df_f

def build_pipeline():
    num_cols = [
        "age", "annual_spend", "delivery_dist_km", "orders_placed",
        "service_calls", "days_active", "avg_spend_per_order",
        "order_frequency_monthly", "support_intensity"
    ]
    cat_cols = ["membership_tier"]
    passthrough_cols = ["promo_code_used", "is_vip_tier"]

    num_transformer = Pipeline([
        ("imputer", SimpleImputer(strategy="median")),
        ("scaler", RobustScaler())
    ])
    cat_transformer = Pipeline([
        ("imputer", SimpleImputer(strategy="most_frequent")),
        ("encoder", OneHotEncoder(handle_unknown="ignore", sparse_output=False))
    ])
    preprocessor = ColumnTransformer([
        ("num", num_transformer, num_cols),
        ("cat", cat_transformer, cat_cols),
        ("pass", "passthrough", passthrough_cols)
    ])
    return preprocessor

# ==============================================================================
# 5. RUN FULL PIPELINE END-TO-END
# ==============================================================================
raw_data = load_data("raw_customer_logistics.csv")
cleaned_data = clean(raw_data)
featured_data = add_features(cleaned_data)

X = featured_data.drop(columns=["customer_id", "churn"])
y = featured_data["churn"]

X_train_raw, X_test_raw, y_train, y_test = train_test_split(
    X, y, test_size=0.20, stratify=y, random_state=42
)

pipeline = build_pipeline()
X_train = pipeline.fit_transform(X_train_raw)
X_test = pipeline.transform(X_test_raw)

print("\n--- 5. Final Output Shapes ---")
print(f"X_train: {X_train.shape}")
print(f"X_test:  {X_test.shape}")
print(f"y_train: {y_train.shape}")
print(f"y_test:  {y_test.shape}")

# ==============================================================================
# 6. QUALITY ASSERTIONS
# ==============================================================================
assert not np.isnan(X_train).any(), "NaN found in X_train"
assert not np.isnan(X_test).any(), "NaN found in X_test"
assert X_train.shape[1] == X_test.shape[1], "Column mismatch"
assert (np.var(X_train, axis=0) > 0).all(), "Zero-variance column found in X_train"
assert (np.var(X_test, axis=0) > 0).all(), "Zero-variance column found in X_test"
print("\n--- 6. Assertions ---")
print("All assertions passed successfully (0 NaNs, equal columns, non-zero variance).")

# ==============================================================================
